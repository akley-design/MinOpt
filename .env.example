# Copy to .env if you export env vars yourself; MinSync reads process env only.
# Data dir (default: %LOCALAPPDATA%\MinSync on Windows)
# MINSYNC_DATA_DIR=
MINSYNC_MAX_CONCURRENT_TASKS=2
MINSYNC_TASK_TIMEOUT_SECONDS=120
MINSYNC_MAX_TIMEOUT_SECONDS=900
MINSYNC_MEMORY_MB=512
MINSYNC_CPUS=1.0
MINSYNC_PIDS_LIMIT=128
MINSYNC_MAX_OUTPUT_BYTES=262144
MINSYNC_MAX_FILE_BYTES=5242880
MINSYNC_MAX_ARCHIVE_BYTES=20971520
MINSYNC_MAX_ARTIFACT_BYTES=52428800
# disabled (no network, default) | approved (unrestricted bridge, explicit opt-in)
MINSYNC_DEFAULT_NETWORK=disabled
# Never put real tokens here if this file is committed. No secrets are sent to containers by default.
